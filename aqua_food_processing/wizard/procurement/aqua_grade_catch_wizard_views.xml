<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_grade_catch_wizard_form" model="ir.ui.view">
        <field name="name">aqua.grade.catch.wizard.form</field>
        <field name="model">aqua.grade.catch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="catch_receipt_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="grading_standard_id"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_aqua_weighment_entry_wizard_form" model="ir.ui.view">
        <field name="name">aqua.weighment.entry.wizard.form</field>
        <field name="model">aqua.weighment.entry.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="catch_receipt_id" invisible="1"/>
                <group>
                    <field name="gross_weight"/>
                    <field name="tare_weight"/>
                    <field name="net_weight" readonly="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
