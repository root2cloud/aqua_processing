<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_issue_coa_wizard_form" model="ir.ui.view">
        <field name="name">aqua.issue.coa.wizard.form</field>
        <field name="model">aqua.issue.coa.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="quality_test_ids" widget="many2many_tags"/>
                    <field name="certifying_body_id"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Issue Certificate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
