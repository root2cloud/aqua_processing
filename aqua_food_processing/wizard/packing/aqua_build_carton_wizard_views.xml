<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_build_carton_wizard_form" model="ir.ui.view">
        <field name="name">aqua.build.carton.wizard.form</field>
        <field name="model">aqua.build.carton.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="pack_order_id" invisible="1"/>
                <group>
                    <field name="total_weight"/>
                    <field name="barcode"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Build Carton" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
