<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_record_yield_wizard_form" model="ir.ui.view">
        <field name="name">aqua.record.yield.wizard.form</field>
        <field name="model">aqua.record.yield.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="processing_order_id" invisible="1"/>
                <group>
                    <field name="grading_standard_id"/>
                    <field name="qty_output"/>
                    <field name="byproduct_type"/>
                    <field name="qty_byproduct"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
