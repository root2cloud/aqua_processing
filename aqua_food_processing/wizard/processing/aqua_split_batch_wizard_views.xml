<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_split_batch_wizard_form" model="ir.ui.view">
        <field name="name">aqua.split.batch.wizard.form</field>
        <field name="model">aqua.split.batch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="processing_order_id" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="grading_standard_id"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
