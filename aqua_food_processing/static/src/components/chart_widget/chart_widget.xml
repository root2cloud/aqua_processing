<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="aqua_food_processing.ChartWidget">
  <div class="aqua-chart-card">

    <div class="aqua-chart-card__header">
      <div class="aqua-chart-card__title">
        <t t-esc="props.title"/>
      </div>
      <div class="aqua-chart-card__actions">
        <button class="aqua-chart-card__action-btn" t-on-click="onExportChart"
                title="Export chart as PNG">
          &#8595; PNG
        </button>
      </div>
    </div>

    <!-- Canvas is always mounted; the loading spinner is an overlay drawn on
         top of it, not a replacement for it, so toggling isLoading never
         destroys/recreates the canvas element itself. -->
    <div class="aqua-chart-card__canvas-wrap" t-att-style="'height:' + props.height + 'px;position:relative;'">
      <canvas t-ref="chartCanvas" style="width:100%;height:100%;"/>
      <t t-if="props.isLoading">
        <div class="aqua-loading-overlay" style="position:absolute;inset:0;">
          <span class="aqua-spinner"/>
        </div>
      </t>
    </div>

  </div>
</t>

</templates>