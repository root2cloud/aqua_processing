<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="aqua_food_processing.FilterBar">
  <t t-set="periodLabel" t-value="periodOptions.find((o) => o.value === state.period).label"/>
  <t t-set="compareLabel" t-value="compareOptions.find((o) => o.value === state.compare).label"/>

  <div class="aqua-dropdown">
    <div class="pill-input filter-pill aqua-dropdown-trigger aqua-tooltip" data-aqua-tooltip="Filter by period"
         t-att-class="{ 'aqua-dropdown-trigger--open': state.openMenu === 'period' }"
         t-on-click="() => this.toggleMenu('period')">
      <svg class="aqua-filter-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="16" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M3 10H21" stroke="currentColor" stroke-width="1.8"/><path d="M8 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <span t-esc="periodLabel"/>
      <i class="fa fa-chevron-down"/>
    </div>
    <t t-if="state.openMenu === 'period'">
      <div class="aqua-dropdown-panel">
        <t t-foreach="periodOptions" t-as="opt" t-key="opt.value">
          <div class="aqua-dropdown-option"
               t-att-class="{ 'aqua-dropdown-option--active': state.period === opt.value }"
               t-on-click="() => this.selectPeriod(opt.value)">
            <span t-esc="opt.label"/>
            <i t-if="state.period === opt.value" class="fa fa-check"/>
          </div>
        </t>
      </div>
    </t>
  </div>

  <t t-if="state.period === 'custom'">
    <div class="pill-input">
      <svg class="aqua-filter-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="16" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M3 10H21" stroke="currentColor" stroke-width="1.8"/><path d="M8 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input type="date" t-att-value="state.customFrom" t-on-change="onCustomFromChange" title="From"/>
    </div>
    <div class="pill-input">
      <svg class="aqua-filter-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="5" width="18" height="16" rx="4" stroke="currentColor" stroke-width="1.8"/><path d="M3 10H21" stroke="currentColor" stroke-width="1.8"/><path d="M8 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M16 3V7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input type="date" t-att-value="state.customTo" t-on-change="onCustomToChange" title="To"/>
    </div>
  </t>

  <div class="aqua-dropdown">
    <div class="pill-input filter-pill aqua-dropdown-trigger aqua-tooltip" data-aqua-tooltip="Compare to a previous period"
         t-att-class="{ 'aqua-dropdown-trigger--open': state.openMenu === 'compare' }"
         t-on-click="() => this.toggleMenu('compare')">
      <svg class="aqua-filter-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 12H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 18H20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="9" cy="6" r="2.2" fill="currentColor"/><circle cx="16" cy="12" r="2.2" fill="currentColor"/><circle cx="10" cy="18" r="2.2" fill="currentColor"/></svg>
      <span t-esc="compareLabel"/>
      <i class="fa fa-chevron-down"/>
    </div>
    <t t-if="state.openMenu === 'compare'">
      <div class="aqua-dropdown-panel">
        <t t-foreach="compareOptions" t-as="opt" t-key="opt.value">
          <div class="aqua-dropdown-option"
               t-att-class="{ 'aqua-dropdown-option--active': state.compare === opt.value }"
               t-on-click="() => this.selectCompare(opt.value)">
            <span t-esc="opt.label"/>
            <i t-if="state.compare === opt.value" class="fa fa-check"/>
          </div>
        </t>
      </div>
    </t>
  </div>

</t>

</templates>