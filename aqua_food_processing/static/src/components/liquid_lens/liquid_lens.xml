<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="aqua_food_processing.LiquidLens">
    <!-- A WebGL fluid simulation that stirs the *real* dashboard content
         wherever the cursor moves - see liquid_lens.js for the full
         explanation and how it maps to the reference effect
         (https://liquid-image.learnframer.site/). Every couple of seconds
         it grabs a fresh html2canvas snapshot of the real dashboard (every
         card, chart, gap - not a fake background image) and uploads it as
         a texture; every animation frame the fluid sim displaces that
         texture per-pixel wherever a cursor-seeded velocity/dye field is
         still disturbed, and is fully transparent everywhere else. There
         is no lens shape here: the div below covers its parent edge-to-edge
         and only ever shows through where content is actively rippling.
         pointer-events:none so it never blocks clicks on the real UI it's
         disturbing. -->
    <div class="aqua-liquid-lens" t-ref="liquidLens">
        <canvas t-ref="liquidLensCanvas"></canvas>
    </div>
</t>

</templates>