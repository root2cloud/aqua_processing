<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aqua_food_processing.DashboardMain">
        <div class="o_aqua_dashboard">
            <div class="o_aqua_header">
                <h2><i class="fa fa-anchor mr-2"/> Aqua Processing </h2>
            </div>

            <!-- TAB BAR -->
            <div class="o_aqua_tabs">
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('overview') }"
                        t-on-click="() => this.setActiveTab('overview')">
                    <i class="fa fa-th-large mr-1"/> Overview
                </button>
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('procurement') }"
                        t-on-click="() => this.setActiveTab('procurement')">
                    <i class="fa fa-truck mr-1"/> Procurement
                </button>
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('processing') }"
                        t-on-click="() => this.setActiveTab('processing')">
                    <i class="fa fa-industry mr-1"/> Processing
                </button>
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('quality') }"
                        t-on-click="() => this.setActiveTab('quality')">
                    <i class="fa fa-flask mr-1"/> Quality Control
                </button>
            </div>

            <!-- ══════════════════════ OVERVIEW TAB ══════════════════════ -->
            <t t-if="isTabActive('overview')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'Total Catch Receipts'"
                        value="state.total_receipts"
                        valueFmt="'number'"
                        icon="'fa-truck'"
                        color="'#2C7A7B'"
                        sparklineData="receiptsSparkline"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalReceipts"/>
                    <KpiTile
                        label="'Accepted Receipts'"
                        value="state.accepted_receipts"
                        valueFmt="'number'"
                        icon="'fa-check-circle'"
                        color="'#3182CE'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillAcceptedReceipts"/>
                    <KpiTile
                        label="'QC Pass Rate'"
                        value="state.qc_pass_rate"
                        valueFmt="'pct'"
                        icon="'fa-flask'"
                        color="'#38A169'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcPassRate"/>
                    <KpiTile
                        label="'On-time Dispatch Rate'"
                        value="state.on_time_dispatch_rate"
                        valueFmt="'pct'"
                        icon="'fa-ship'"
                        color="'#D69E2E'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillDispatchRate"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.receipts_by_species.length">
                            <ChartWidget
                                title="'Receipts by Species'"
                                chartType="'horizontalBar'"
                                data="speciesChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onSpeciesChartClick"
                                exportFilename="'aqua_receipts_by_species'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Receipts by Species</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.qc_breakdown.length">
                            <ChartWidget
                                title="'QC Result Breakdown'"
                                chartType="'doughnut'"
                                data="qcChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onQcChartClick"
                                exportFilename="'aqua_qc_breakdown'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">QC Result Breakdown</div></div><div class="o_aqua_empty">No QC tests recorded yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.shipment_breakdown.length">
                            <ChartWidget
                                title="'Shipment Status'"
                                chartType="'doughnut'"
                                data="shipmentChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onShipmentChartClick"
                                exportFilename="'aqua_shipment_status'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Shipment Status</div></div><div class="o_aqua_empty">No shipments recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.receipt_trend.length">
                            <ChartWidget
                                title="'Weekly Receipt Trend'"
                                chartType="'line'"
                                data="receiptTrendChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onReceiptTrendChartClick"
                                exportFilename="'aqua_receipt_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Weekly Receipt Trend</div></div><div class="o_aqua_empty">Not enough data yet for a trend line.</div></div></t>
                    </div>
                </div>
            </t>

            <!-- ══════════════════════ PROCUREMENT TAB ══════════════════════ -->
            <!-- Covers the full purchase -> storage flow: Purchase Order -> Catch
                 Receipt -> Deliveries -> weight reconciliation -> vendor performance. -->
            <t t-if="isTabActive('procurement')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'Total Catch Receipts'"
                        value="state.total_receipts"
                        valueFmt="'number'"
                        icon="'fa-truck'"
                        color="'#2C7A7B'"
                        sparklineData="receiptsSparkline"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalReceipts"/>
                    <KpiTile
                        label="'Completed Receipts'"
                        value="state.accepted_receipts"
                        valueFmt="'number'"
                        icon="'fa-check-circle'"
                        color="'#38A169'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillAcceptedReceipts"/>
                    <KpiTile
                        label="'Cancelled / Rejected'"
                        value="state.cancelled_receipts"
                        valueFmt="'number'"
                        icon="'fa-times-circle'"
                        color="'#C53030'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillCancelledReceipts"/>
                    <KpiTile
                        label="'Total Weight Received (kg)'"
                        value="state.total_weight_received"
                        valueFmt="'number'"
                        icon="'fa-balance-scale'"
                        color="'#3182CE'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalWeightReceived"/>
                    <KpiTile
                        label="'Total Purchase Spend'"
                        value="state.total_purchase_spend"
                        valueFmt="'number'"
                        icon="'fa-money'"
                        color="'#805AD5'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalPurchaseSpend"/>
                    <KpiTile
                        label="'Active Vendors'"
                        value="state.active_vendor_count"
                        valueFmt="'number'"
                        icon="'fa-users'"
                        color="'#D69E2E'"
                        isLoading="state.isLoading"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.receipts_by_species.length">
                            <ChartWidget
                                title="'Receipts by Species'"
                                chartType="'horizontalBar'"
                                data="speciesChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onSpeciesChartClick"
                                exportFilename="'aqua_receipts_by_species'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Receipts by Species</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.receipt_trend.length">
                            <ChartWidget
                                title="'Weekly Receipt Trend'"
                                chartType="'line'"
                                data="receiptTrendChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onReceiptTrendChartClick"
                                exportFilename="'aqua_receipt_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Weekly Receipt Trend</div></div><div class="o_aqua_empty">Not enough data yet for a trend line.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.receipt_status_breakdown.length">
                            <ChartWidget
                                title="'Receipt Status Breakdown'"
                                chartType="'doughnut'"
                                data="receiptStatusChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onReceiptStatusChartClick"
                                exportFilename="'aqua_receipt_status'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Receipt Status Breakdown</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.spend_by_vendor.length">
                            <ChartWidget
                                title="'Purchase Spend by Vendor'"
                                chartType="'horizontalBar'"
                                data="spendByVendorChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onSpendByVendorChartClick"
                                exportFilename="'aqua_spend_by_vendor'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Purchase Spend by Vendor</div></div><div class="o_aqua_empty">No confirmed purchase orders yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.weight_by_vendor.length">
                            <ChartWidget
                                title="'Received Weight by Vendor (kg)'"
                                chartType="'horizontalBar'"
                                data="weightByVendorChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onWeightByVendorChartClick"
                                exportFilename="'aqua_weight_by_vendor'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Received Weight by Vendor (kg)</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.ordered_vs_received.length">
                            <ChartWidget
                                title="'Ordered vs Received Weight (kg)'"
                                chartType="'bar'"
                                data="orderedVsReceivedChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onOrderedVsReceivedChartClick"
                                exportFilename="'aqua_ordered_vs_received'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Ordered vs Received Weight (kg)</div></div><div class="o_aqua_empty">No PO-linked catch receipts yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_panel_full">
                    <div class="aqua-chart-card">
                        <div class="aqua-chart-card__header">
                            <div class="aqua-chart-card__title">Recent Catch Receipts — Purchase to Storage</div>
                        </div>
                        <t t-if="state.recent_receipts_table.length">
                            <table class="o_aqua_table">
                                <thead>
                                    <tr>
                                        <th>Receipt</th>
                                        <th>Vendor</th>
                                        <th>PO</th>
                                        <th>Species</th>
                                        <th>Ordered (kg)</th>
                                        <th>Net Weight (kg)</th>
                                        <th>Total Received (kg)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_receipts_table" t-as="row" t-key="row.id">
                                        <tr class="o_aqua_table_row_clickable" t-on-click="() => this.onRecentReceiptRowClick(row.id)">
                                            <td t-esc="row.name"/>
                                            <td t-esc="row.vendor"/>
                                            <td t-esc="row.po"/>
                                            <td t-esc="row.species"/>
                                            <td t-esc="row.ordered_qty"/>
                                            <td t-esc="row.net_weight"/>
                                            <td t-esc="row.total_received"/>
                                            <td t-esc="row.state"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="o_aqua_empty">No catch receipts recorded yet.</div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- ══════════════════════ PROCESSING TAB ══════════════════════ -->
            <t t-if="isTabActive('processing')">
                <div class="o_aqua_panel_full">
                    <t t-if="state.yield_trend.length">
                        <ChartWidget
                            title="'Recent Processing Orders — Yield %'"
                            chartType="'bar'"
                            data="yieldChartData"
                            isLoading="state.isLoading"
                            onElementClick.bind="onYieldChartClick"
                            exportFilename="'aqua_yield_trend'"/>
                    </t>
                    <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Recent Processing Orders — Yield %</div></div><div class="o_aqua_empty">No processing orders recorded yet.</div></div></t>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.cold_room_utilization.length">
                            <ChartWidget
                                title="'Cold Room Utilization'"
                                chartType="'horizontalBar'"
                                data="coldRoomChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onColdRoomChartClick"
                                exportFilename="'aqua_cold_room_utilization'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Cold Room Utilization</div></div><div class="o_aqua_empty">No cold rooms configured yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <div class="aqua-chart-card">
                            <div class="aqua-chart-card__header">
                                <div class="aqua-chart-card__title">Cold Room Detail</div>
                            </div>
                            <t t-if="state.cold_room_utilization.length">
                                <table class="o_aqua_table">
                                    <thead><tr><th>Room</th><th>Capacity (kg)</th><th>Active Lots</th></tr></thead>
                                    <tbody>
                                        <t t-foreach="state.cold_room_utilization" t-as="room" t-key="room.name">
                                            <tr class="o_aqua_table_row_clickable" t-on-click="() => this.onColdRoomChartClick({label: room.name})">
                                                <td t-esc="room.name"/>
                                                <td t-esc="room.capacity_kg"/>
                                                <td t-esc="room.lots"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </t>
                            <t t-else="">
                                <div class="o_aqua_empty">No cold rooms configured yet.</div>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- ══════════════════════ QUALITY CONTROL TAB ══════════════════════ -->
            <t t-if="isTabActive('quality')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'QC Pass Rate'"
                        value="state.qc_pass_rate"
                        valueFmt="'pct'"
                        icon="'fa-flask'"
                        color="'#38A169'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcPassRate"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_full">
                        <t t-if="state.qc_breakdown.length">
                            <ChartWidget
                                title="'QC Result Breakdown'"
                                chartType="'doughnut'"
                                data="qcChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onQcChartClick"
                                exportFilename="'aqua_qc_breakdown'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">QC Result Breakdown</div></div><div class="o_aqua_empty">No QC tests recorded yet.</div></div></t>
                    </div>
                </div>
            </t>

            <DrillPanel
                isOpen="state.drill.isOpen"
                title="state.drill.title"
                model="state.drill.model"
                records="state.drill.records"
                columns="state.drill.columns"
                isLoading="state.drill.loading"
                onClose.bind="closeDrill"/>

        </div>
    </t>
</templates>