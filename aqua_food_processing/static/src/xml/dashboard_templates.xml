<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="aqua_food_processing.DashboardMain">
        <div class="o_aqua_dashboard">
            <div class="o_aqua_header">
                <h2><i class="fa fa-anchor mr-2"/> Aqua Processing </h2>
            </div>

            <!-- TAB BAR -->
            <div class="o_aqua_tabs">
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('overview') }"
                        t-on-click="() => this.setActiveTab('overview')">
                    <i class="fa fa-th-large mr-1"/> Overview
                </button>
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('procurement') }"
                        t-on-click="() => this.setActiveTab('procurement')">
                    <i class="fa fa-truck mr-1"/> Procurement
                </button>
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('processing') }"
                        t-on-click="() => this.setActiveTab('processing')">
                    <i class="fa fa-industry mr-1"/> Processing
                </button>
                <button type="button"
                        class="o_aqua_tab_btn"
                        t-att-class="{ o_aqua_tab_active: isTabActive('quality') }"
                        t-on-click="() => this.setActiveTab('quality')">
                    <i class="fa fa-flask mr-1"/> Quality Control
                </button>
            </div>

            <!-- ══════════════════════ OVERVIEW TAB ══════════════════════ -->
            <t t-if="isTabActive('overview')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'Total Catch Receipts'"
                        value="state.total_receipts"
                        valueFmt="'number'"
                        icon="'fa-truck'"
                        color="'#2C7A7B'"
                        sparklineData="receiptsSparkline"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalReceipts"/>
                    <KpiTile
                        label="'Accepted Receipts'"
                        value="state.accepted_receipts"
                        valueFmt="'number'"
                        icon="'fa-check-circle'"
                        color="'#3182CE'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillAcceptedReceipts"/>
                    <KpiTile
                        label="'QC Pass Rate'"
                        value="state.qc_pass_rate"
                        valueFmt="'pct'"
                        icon="'fa-flask'"
                        color="'#38A169'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcPassRate"/>
                    <KpiTile
                        label="'On-time Dispatch Rate'"
                        value="state.on_time_dispatch_rate"
                        valueFmt="'pct'"
                        icon="'fa-ship'"
                        color="'#D69E2E'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillDispatchRate"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.receipts_by_species.length">
                            <ChartWidget
                                title="'Receipts by Species'"
                                chartType="'horizontalBar'"
                                data="speciesChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onSpeciesChartClick"
                                exportFilename="'aqua_receipts_by_species'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Receipts by Species</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.qc_breakdown.length">
                            <ChartWidget
                                title="'QC Result Breakdown'"
                                chartType="'doughnut'"
                                data="qcChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onQcChartClick"
                                exportFilename="'aqua_qc_breakdown'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">QC Result Breakdown</div></div><div class="o_aqua_empty">No QC tests recorded yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.shipment_breakdown.length">
                            <ChartWidget
                                title="'Shipment Status'"
                                chartType="'doughnut'"
                                data="shipmentChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onShipmentChartClick"
                                exportFilename="'aqua_shipment_status'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Shipment Status</div></div><div class="o_aqua_empty">No shipments recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.receipt_trend.length">
                            <ChartWidget
                                title="'Weekly Receipt Trend'"
                                chartType="'line'"
                                data="receiptTrendChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onReceiptTrendChartClick"
                                exportFilename="'aqua_receipt_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Weekly Receipt Trend</div></div><div class="o_aqua_empty">Not enough data yet for a trend line.</div></div></t>
                    </div>
                </div>
            </t>

            <!-- ══════════════════════ PROCUREMENT TAB ══════════════════════ -->
            <!-- Covers the full purchase -> storage flow: Purchase Order -> Catch
                 Receipt -> Deliveries -> weight reconciliation -> vendor performance. -->
            <t t-if="isTabActive('procurement')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'Total Catch Receipts'"
                        value="state.total_receipts"
                        valueFmt="'number'"
                        icon="'fa-truck'"
                        color="'#2C7A7B'"
                        sparklineData="receiptsSparkline"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalReceipts"/>
                    <KpiTile
                        label="'Completed Receipts'"
                        value="state.accepted_receipts"
                        valueFmt="'number'"
                        icon="'fa-check-circle'"
                        color="'#38A169'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillAcceptedReceipts"/>
                    <KpiTile
                        label="'Cancelled / Rejected'"
                        value="state.cancelled_receipts"
                        valueFmt="'number'"
                        icon="'fa-times-circle'"
                        color="'#C53030'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillCancelledReceipts"/>
                    <KpiTile
                        label="'Total Weight Received (kg)'"
                        value="state.total_weight_received"
                        valueFmt="'number'"
                        icon="'fa-balance-scale'"
                        color="'#3182CE'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalWeightReceived"/>
                    <KpiTile
                        label="'Total Purchase Spend'"
                        value="state.total_purchase_spend"
                        valueFmt="'number'"
                        icon="'fa-money'"
                        color="'#805AD5'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalPurchaseSpend"/>
                    <KpiTile
                        label="'Active Vendors'"
                        value="state.active_vendor_count"
                        valueFmt="'number'"
                        icon="'fa-users'"
                        color="'#D69E2E'"
                        isLoading="state.isLoading"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.receipts_by_species.length">
                            <ChartWidget
                                title="'Receipts by Species'"
                                chartType="'horizontalBar'"
                                data="speciesChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onSpeciesChartClick"
                                exportFilename="'aqua_receipts_by_species'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Receipts by Species</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.receipt_trend.length">
                            <ChartWidget
                                title="'Weekly Receipt Trend'"
                                chartType="'line'"
                                data="receiptTrendChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onReceiptTrendChartClick"
                                exportFilename="'aqua_receipt_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Weekly Receipt Trend</div></div><div class="o_aqua_empty">Not enough data yet for a trend line.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.receipt_status_breakdown.length">
                            <ChartWidget
                                title="'Receipt Status Breakdown'"
                                chartType="'doughnut'"
                                data="receiptStatusChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onReceiptStatusChartClick"
                                exportFilename="'aqua_receipt_status'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Receipt Status Breakdown</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.spend_by_vendor.length">
                            <ChartWidget
                                title="'Purchase Spend by Vendor'"
                                chartType="'horizontalBar'"
                                data="spendByVendorChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onSpendByVendorChartClick"
                                exportFilename="'aqua_spend_by_vendor'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Purchase Spend by Vendor</div></div><div class="o_aqua_empty">No confirmed purchase orders yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.weight_by_vendor.length">
                            <ChartWidget
                                title="'Received Weight by Vendor (kg)'"
                                chartType="'horizontalBar'"
                                data="weightByVendorChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onWeightByVendorChartClick"
                                exportFilename="'aqua_weight_by_vendor'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Received Weight by Vendor (kg)</div></div><div class="o_aqua_empty">No catch receipts recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.ordered_vs_received.length">
                            <ChartWidget
                                title="'Ordered vs Received Weight (kg)'"
                                chartType="'bar'"
                                data="orderedVsReceivedChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onOrderedVsReceivedChartClick"
                                exportFilename="'aqua_ordered_vs_received'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Ordered vs Received Weight (kg)</div></div><div class="o_aqua_empty">No PO-linked catch receipts yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_panel_full">
                    <div class="aqua-chart-card">
                        <div class="aqua-chart-card__header">
                            <div class="aqua-chart-card__title">Recent Catch Receipts — Purchase to Storage</div>
                        </div>
                        <t t-if="state.recent_receipts_table.length">
                            <table class="o_aqua_table">
                                <thead>
                                    <tr>
                                        <th>Receipt</th>
                                        <th>Vendor</th>
                                        <th>PO</th>
                                        <th>Species</th>
                                        <th>Ordered (kg)</th>
                                        <th>Net Weight (kg)</th>
                                        <th>Total Received (kg)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_receipts_table" t-as="row" t-key="row.id">
                                        <tr class="o_aqua_table_row_clickable" t-on-click="() => this.onRecentReceiptRowClick(row.id)">
                                            <td t-esc="row.name"/>
                                            <td t-esc="row.vendor"/>
                                            <td t-esc="row.po"/>
                                            <td t-esc="row.species"/>
                                            <td t-esc="row.ordered_qty"/>
                                            <td t-esc="row.net_weight"/>
                                            <td t-esc="row.total_received"/>
                                            <td t-esc="row.state"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="o_aqua_empty">No catch receipts recorded yet.</div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- ══════════════════════ PROCESSING TAB ══════════════════════ -->
            <!-- Covers the full intake -> yield -> cold storage flow: Catch Receipt ->
                 Processing Order (input qty, yield %, by-product yield %) -> Blast Freeze
                 -> Cold Room storage. -->
            <t t-if="isTabActive('processing')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'Total Processing Orders'"
                        value="state.total_processing_orders"
                        valueFmt="'number'"
                        icon="'fa-industry'"
                        color="'#2C7A7B'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalProcessingOrders"/>
                    <KpiTile
                        label="'Total Input (kg)'"
                        value="state.total_input_qty"
                        valueFmt="'number'"
                        icon="'fa-balance-scale'"
                        color="'#3182CE'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillTotalProcessingOrders"/>
                    <KpiTile
                        label="'Avg Product Yield %'"
                        value="state.avg_yield_pct"
                        valueFmt="'pct'"
                        icon="'fa-percent'"
                        color="'#805AD5'"
                        isLoading="state.isLoading"/>
                    <KpiTile
                        label="'Avg By-product Yield %'"
                        value="state.avg_byproduct_yield_pct"
                        valueFmt="'pct'"
                        icon="'fa-recycle'"
                        color="'#D69E2E'"
                        isLoading="state.isLoading"/>
                    <KpiTile
                        label="'Active Blast Freeze Cycles'"
                        value="state.active_blast_freeze_count"
                        valueFmt="'number'"
                        icon="'fa-snowflake-o'"
                        color="'#38A169'"
                        isLoading="state.isLoading"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.yield_trend.length">
                            <ChartWidget
                                title="'Recent Processing Orders — Yield %'"
                                chartType="'bar'"
                                data="yieldChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onYieldChartClick"
                                exportFilename="'aqua_yield_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Recent Processing Orders — Yield %</div></div><div class="o_aqua_empty">No processing orders recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.processing_status_breakdown.length">
                            <ChartWidget
                                title="'Processing Order Status'"
                                chartType="'doughnut'"
                                data="processingStatusChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onProcessingStatusChartClick"
                                exportFilename="'aqua_processing_status'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Processing Order Status</div></div><div class="o_aqua_empty">No processing orders recorded yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.input_qty_by_species.length">
                            <ChartWidget
                                title="'Input Weight by Species (kg)'"
                                chartType="'horizontalBar'"
                                data="inputQtyBySpeciesChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onInputQtyBySpeciesChartClick"
                                exportFilename="'aqua_input_qty_by_species'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Input Weight by Species (kg)</div></div><div class="o_aqua_empty">No processing orders recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.byproduct_yield_trend.length">
                            <ChartWidget
                                title="'By-product Yield % Trend'"
                                chartType="'line'"
                                data="byproductYieldChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onByproductYieldChartClick"
                                exportFilename="'aqua_byproduct_yield_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">By-product Yield % Trend</div></div><div class="o_aqua_empty">Not enough data yet for a trend line.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.cold_room_utilization.length">
                            <ChartWidget
                                title="'Cold Room Utilization'"
                                chartType="'horizontalBar'"
                                data="coldRoomChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onColdRoomChartClick"
                                exportFilename="'aqua_cold_room_utilization'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Cold Room Utilization</div></div><div class="o_aqua_empty">No cold rooms configured yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.blast_freeze_status.length">
                            <ChartWidget
                                title="'Blast Freeze Cycle Status'"
                                chartType="'doughnut'"
                                data="blastFreezeChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onBlastFreezeChartClick"
                                exportFilename="'aqua_blast_freeze_status'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Blast Freeze Cycle Status</div></div><div class="o_aqua_empty">No blast freeze cycles recorded yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_panel_full">
                    <div class="aqua-chart-card">
                        <div class="aqua-chart-card__header">
                            <div class="aqua-chart-card__title">Cold Room Detail</div>
                        </div>
                        <t t-if="state.cold_room_utilization.length">
                            <table class="o_aqua_table">
                                <thead><tr><th>Room</th><th>Capacity (kg)</th><th>Active Lots</th><th>Utilization %</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.cold_room_utilization" t-as="room" t-key="room.name">
                                        <tr class="o_aqua_table_row_clickable" t-on-click="() => this.onColdRoomChartClick({label: room.name})">
                                            <td t-esc="room.name"/>
                                            <td t-esc="room.capacity_kg"/>
                                            <td t-esc="room.lots"/>
                                            <td t-esc="room.pct"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="o_aqua_empty">No cold rooms configured yet.</div>
                        </t>
                    </div>
                </div>

                <div class="o_aqua_panel_full">
                    <div class="aqua-chart-card">
                        <div class="aqua-chart-card__header">
                            <div class="aqua-chart-card__title">Recent Processing Orders — Intake to Yield</div>
                        </div>
                        <t t-if="state.recent_processing_table.length">
                            <table class="o_aqua_table">
                                <thead>
                                    <tr>
                                        <th>Order</th>
                                        <th>Species</th>
                                        <th>Catch Receipt</th>
                                        <th>Input (kg)</th>
                                        <th>Yield %</th>
                                        <th>By-product Yield %</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_processing_table" t-as="row" t-key="row.id">
                                        <tr class="o_aqua_table_row_clickable" t-on-click="() => this.onRecentProcessingRowClick(row.id)">
                                            <td t-esc="row.name"/>
                                            <td t-esc="row.species"/>
                                            <td t-esc="row.catch_receipt"/>
                                            <td t-esc="row.qty_input"/>
                                            <td t-esc="row.yield_percentage"/>
                                            <td t-esc="row.byproduct_yield_percentage"/>
                                            <td t-esc="row.state"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="o_aqua_empty">No processing orders recorded yet.</div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- ══════════════════════ QUALITY CONTROL TAB ══════════════════════ -->
            <!-- Covers the full inspection checklist lifecycle: Raw Material (Receiving)
                 -> In-Process -> Final / Pre-Shipment, including residue screening and
                 intake decisions. -->
            <t t-if="isTabActive('quality')">
                <div class="o_aqua_kpi_row">
                    <KpiTile
                        label="'QC Pass Rate'"
                        value="state.qc_pass_rate"
                        valueFmt="'pct'"
                        icon="'fa-flask'"
                        color="'#38A169'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcPassRate"/>
                    <KpiTile
                        label="'Total Checks'"
                        value="state.qc_total"
                        valueFmt="'number'"
                        icon="'fa-clipboard'"
                        color="'#2C7A7B'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcTotal"/>
                    <KpiTile
                        label="'Failed Checks'"
                        value="state.qc_fail_count"
                        valueFmt="'number'"
                        icon="'fa-times-circle'"
                        color="'#C53030'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcFail"/>
                    <KpiTile
                        label="'On Hold'"
                        value="state.qc_hold_count"
                        valueFmt="'number'"
                        icon="'fa-pause-circle'"
                        color="'#D69E2E'"
                        isLoading="state.isLoading"
                        onDrill.bind="onDrillQcHold"/>
                    <KpiTile
                        label="'Avg Histamine (ppm)'"
                        value="state.avg_histamine_ppm"
                        valueFmt="'number'"
                        icon="'fa-vial'"
                        color="'#805AD5'"
                        isLoading="state.isLoading"/>
                    <KpiTile
                        label="'Avg Sensory Score (0-10)'"
                        value="state.avg_sensory_score"
                        valueFmt="'number'"
                        icon="'fa-star'"
                        color="'#3182CE'"
                        isLoading="state.isLoading"/>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.qc_breakdown.length">
                            <ChartWidget
                                title="'QC Result Breakdown'"
                                chartType="'doughnut'"
                                data="qcChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onQcChartClick"
                                exportFilename="'aqua_qc_breakdown'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">QC Result Breakdown</div></div><div class="o_aqua_empty">No QC tests recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.qc_stage_breakdown.length">
                            <ChartWidget
                                title="'Checks by Lifecycle Stage'"
                                chartType="'doughnut'"
                                data="qcStageChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onQcStageChartClick"
                                exportFilename="'aqua_qc_stage_breakdown'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Checks by Lifecycle Stage</div></div><div class="o_aqua_empty">No QC tests recorded yet.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_narrow">
                        <t t-if="state.intake_decision_breakdown.length">
                            <ChartWidget
                                title="'Intake Decision (Raw Material)'"
                                chartType="'doughnut'"
                                data="intakeDecisionChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onIntakeDecisionChartClick"
                                exportFilename="'aqua_intake_decision'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Intake Decision (Raw Material)</div></div><div class="o_aqua_empty">No intake decisions recorded yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.qc_trend.length">
                            <ChartWidget
                                title="'Weekly QC Checks Trend'"
                                chartType="'line'"
                                data="qcTrendChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onQcTrendChartClick"
                                exportFilename="'aqua_qc_trend'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Weekly QC Checks Trend</div></div><div class="o_aqua_empty">Not enough data yet for a trend line.</div></div></t>
                    </div>
                    <div class="o_aqua_panel_wide">
                        <t t-if="state.residue_screening.labels.length">
                            <ChartWidget
                                title="'Residue Screening Results'"
                                chartType="'bar'"
                                data="residueScreeningChartData"
                                isLoading="state.isLoading"
                                exportFilename="'aqua_residue_screening'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Residue Screening Results</div></div><div class="o_aqua_empty">No residue screening data yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_chart_row">
                    <div class="o_aqua_panel_full">
                        <t t-if="state.rejected_qty_by_species.length">
                            <ChartWidget
                                title="'Rejected Quantity by Species (kg)'"
                                chartType="'horizontalBar'"
                                data="rejectedQtyBySpeciesChartData"
                                isLoading="state.isLoading"
                                onElementClick.bind="onRejectedQtyBySpeciesChartClick"
                                exportFilename="'aqua_rejected_qty_by_species'"/>
                        </t>
                        <t t-else=""><div class="aqua-chart-card"><div class="aqua-chart-card__header"><div class="aqua-chart-card__title">Rejected Quantity by Species (kg)</div></div><div class="o_aqua_empty">No rejected raw material recorded yet.</div></div></t>
                    </div>
                </div>

                <div class="o_aqua_panel_full">
                    <div class="aqua-chart-card">
                        <div class="aqua-chart-card__header">
                            <div class="aqua-chart-card__title">Recent Quality Checks</div>
                        </div>
                        <t t-if="state.recent_qc_table.length">
                            <table class="o_aqua_table">
                                <thead>
                                    <tr>
                                        <th>Check</th>
                                        <th>Stage</th>
                                        <th>Result</th>
                                        <th>Decision</th>
                                        <th>Histamine (ppm)</th>
                                        <th>Core Temp (°C)</th>
                                        <th>On Hold</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_qc_table" t-as="row" t-key="row.id">
                                        <tr class="o_aqua_table_row_clickable" t-on-click="() => this.onRecentQcRowClick(row.id)">
                                            <td t-esc="row.name"/>
                                            <td t-esc="row.stage"/>
                                            <td t-esc="row.result"/>
                                            <td t-esc="row.decision"/>
                                            <td t-esc="row.histamine_ppm"/>
                                            <td t-esc="row.core_temp_c"/>
                                            <td t-esc="row.on_hold ? 'Yes' : 'No'"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <div class="o_aqua_empty">No quality checks recorded yet.</div>
                        </t>
                    </div>
                </div>
            </t>

            <DrillPanel
                isOpen="state.drill.isOpen"
                title="state.drill.title"
                model="state.drill.model"
                records="state.drill.records"
                columns="state.drill.columns"
                isLoading="state.drill.loading"
                onClose.bind="closeDrill"/>

        </div>
    </t>
</templates>