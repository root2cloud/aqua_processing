<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_byproduct_record_list" model="ir.ui.view">
        <field name="name">aqua.byproduct.record.list</field>
        <field name="model">aqua.byproduct.record</field>
        <field name="arch" type="xml">
            <list>
                <field name="processing_order_id"/>
                <field name="byproduct_type"/>
                <field name="qty_recovered"/>
                <field name="recovery_percentage"/>
            </list>
        </field>
    </record>
    <record id="action_aqua_byproduct_record" model="ir.actions.act_window">
        <field name="name">By-product Records</field>
        <field name="res_model">aqua.byproduct.record</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
