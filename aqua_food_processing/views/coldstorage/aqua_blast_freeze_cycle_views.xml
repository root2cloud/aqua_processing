<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_blast_freeze_cycle_list" model="ir.ui.view">
        <field name="name">aqua.blast.freeze.cycle.list</field>
        <field name="model">aqua.blast.freeze.cycle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cold_room_id"/>
                <field name="processing_order_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="duration_hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_aqua_blast_freeze_cycle_form" model="ir.ui.view">
        <field name="name">aqua.blast.freeze.cycle.form</field>
        <field name="model">aqua.blast.freeze.cycle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="oe_highlight"
                            invisible="state != 'scheduled'"/>
                    <button name="action_stop" type="object" string="Stop" class="oe_highlight"
                            invisible="state != 'running'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Scheduled"
                            invisible="state == 'scheduled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,running,completed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <field name="cold_room_id"/>
                        <field name="processing_order_id"/>
                        <field name="start_datetime"/>
                        <field name="end_datetime"/>
                        <field name="duration_hours" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aqua_blast_freeze_cycle" model="ir.actions.act_window">
        <field name="name">Blast Freeze Cycles</field>
        <field name="res_model">aqua.blast.freeze.cycle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
