<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_pallet_list" model="ir.ui.view">
        <field name="name">aqua.pallet.list</field>
        <field name="model">aqua.pallet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="carton_count"/>
                <field name="gross_weight"/>
                <field name="shipment_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_aqua_pallet_form" model="ir.ui.view">
        <field name="name">aqua.pallet.form</field>
        <field name="model">aqua.pallet</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reset_to_draft" type="object" string="Reset to Ready"
                            invisible="state == 'ready'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,loaded,shipped"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_shipment" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="not shipment_id">
                            <div class="o_stat_info"><span class="o_stat_text">Shipment</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <field name="gross_weight" readonly="1"/>
                        <field name="shipment_id"/>
                    </group>
                    <field name="carton_ids">
                        <list>
                            <field name="name"/>
                            <field name="total_weight"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_aqua_pallet" model="ir.actions.act_window">
        <field name="name">Pallets</field>
        <field name="res_model">aqua.pallet</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>