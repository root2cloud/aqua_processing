<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_carton_list" model="ir.ui.view">
        <field name="name">aqua.carton.list</field>
        <field name="model">aqua.carton</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="pack_order_id"/>
                <field name="product_id"/>
                <field name="total_weight"/>
                <field name="unit_pack_weight"/>
                <field name="pack_count"/>
                <field name="pallet_id"/>
                <field name="barcode"/>
            </list>
        </field>
    </record>
    <record id="action_aqua_carton" model="ir.actions.act_window">
        <field name="name">Cartons</field>
        <field name="res_model">aqua.carton</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>