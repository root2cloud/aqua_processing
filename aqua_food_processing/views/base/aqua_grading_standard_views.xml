<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_grading_standard_list" model="ir.ui.view">
        <field name="name">aqua.grading.standard.list</field>
        <field name="model">aqua.grading.standard</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="species_id"/>
                <field name="name"/>
                <field name="min_weight"/>
                <field name="max_weight"/>
            </list>
        </field>
    </record>
    <record id="view_aqua_grading_standard_form" model="ir.ui.view">
        <field name="name">aqua.grading.standard.form</field>
        <field name="model">aqua.grading.standard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="species_id"/>
                        <field name="name"/>
                        <field name="min_weight"/>
                        <field name="max_weight"/>
                        <field name="quality_criteria"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aqua_grading_standard" model="ir.actions.act_window">
        <field name="name">Grading Standards</field>
        <field name="res_model">aqua.grading.standard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
