<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_aqua_inherit" model="ir.ui.view">
        <field name="name">product.template.form.aqua.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="aqua_product_info" string="Aqua Info">
                    <group>
                        <field name="aqua_species_id"/>
                        <field name="aqua_form"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>