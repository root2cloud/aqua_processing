<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_certifying_body_list" model="ir.ui.view">
        <field name="name">aqua.certifying.body.list</field>
        <field name="model">aqua.certifying.body</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="country"/>
            </list>
        </field>
    </record>
    <record id="view_aqua_certifying_body_form" model="ir.ui.view">
        <field name="name">aqua.certifying.body.form</field>
        <field name="model">aqua.certifying.body</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="country"/>
                        <field name="certificate_type_ids"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aqua_certifying_body" model="ir.actions.act_window">
        <field name="name">Certifying Bodies</field>
        <field name="res_model">aqua.certifying.body</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
