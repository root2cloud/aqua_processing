<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_harvest_method_list" model="ir.ui.view">
        <field name="name">aqua.harvest.method.list</field>
        <field name="model">aqua.harvest.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
    <record id="view_aqua_harvest_method_form" model="ir.ui.view">
        <field name="name">aqua.harvest.method.form</field>
        <field name="model">aqua.harvest.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="species_ids" widget="many2many_tags"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aqua_harvest_method" model="ir.actions.act_window">
        <field name="name">Harvest Methods</field>
        <field name="res_model">aqua.harvest.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
