<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_container_list" model="ir.ui.view">
        <field name="name">aqua.container.list</field>
        <field name="model">aqua.container</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="container_number"/>
                <field name="container_type"/>
                <field name="max_weight_kg"/>
            </list>
        </field>
    </record>
    <record id="action_aqua_container" model="ir.actions.act_window">
        <field name="name">Containers</field>
        <field name="res_model">aqua.container</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
