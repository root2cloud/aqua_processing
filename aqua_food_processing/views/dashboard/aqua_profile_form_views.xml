<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Same fields as Odoo's stock "My Profile" quick-edit
         (base.view_users_form_simple_modal) — avatar, name, login/email,
         phone, mobile — just carrying our own root class so the dashboard
         CSS bundle (loaded on web.assets_backend, see __manifest__.py) can
         restyle this one dialog without touching every other form dialog
         in the backend. Opened from the avatar popover, see
         onProfileMenuClick() in static/src/js/dashboard.js. -->
    <record id="aqua_profile_form_view" model="ir.ui.view">
        <field name="name">res.users.form.aqua.profile</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form class="o_aqua_profile_dialog" string="My Profile">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title">
                        <label for="name" string="Name"/>
                        <h1><field name="name" placeholder="e.g. John Doe"/></h1>
                    </div>
                    <group>
                        <field name="login" string="Email Address"/>
                        <field name="phone"/>
                        <field name="mobile"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>