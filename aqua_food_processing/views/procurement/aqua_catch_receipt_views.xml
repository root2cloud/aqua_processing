<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_catch_receipt_list" model="ir.ui.view">
        <field name="name">aqua.catch.receipt.list</field>
        <field name="model">aqua.catch.receipt</field>
        <field name="arch" type="xml">
            <list decoration-muted="state=='cancelled'" decoration-success="state=='completed'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="species_id"/>
                <field name="receipt_date"/>
                <field name="confirmation_date"/>
                <field name="arrival_date"/>
                <field name="ordered_qty" optional="hide"/>
                <field name="total_received"/>
                <field name="delivery_count"/>
                <field name="batch_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="lot_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="batch_number" optional="hide"/>
                <field name="lot_number" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'open'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_aqua_catch_receipt_form" model="ir.ui.view">
        <field name="name">aqua.catch.receipt.form</field>
        <field name="model">aqua.catch.receipt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_deliveries" type="object" string="Update Deliveries"
                            invisible="not purchase_order_id"
                            help="Add a row below for any new Incoming Transfer (delivery) on the Purchase Order that doesn't have one yet. Never touches an existing row."/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_receipts" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="not purchase_order_id">
                            <field name="delivery_count" widget="statinfo" string="Receipts"/>
                        </button>
                        <button name="action_view_processing_orders" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="processing_order_count" widget="statinfo" string="Processing Orders"/>
                        </button>
                        <button name="action_view_quality_tests" type="object" class="oe_stat_button" icon="fa-flask">
                            <field name="quality_test_count" widget="statinfo" string="QC Tests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Catch Details">
                            <field name="vendor_id"/>
                            <field name="species_id"/>
                            <field name="product_id" invisible="1"/>
                            <field name="harvest_method_id"/>
                            <field name="rate_contract_id"/>
                            <field name="vendor_shrimp_count" readonly="1"/>
                        </group>
                        <group string="Purchase &amp; Traceability">
                            <field name="receipt_date"/>
                            <field name="purchase_order_id"/>
                            <field name="confirmation_date" readonly="1"/>
                            <field name="arrival_date" readonly="1"/>
                            <field name="ordered_qty" readonly="1"/>
                            <field name="total_received" readonly="1"/>
                            <field name="delivery_count" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deliveries" name="deliveries">
                            <field name="delivery_ids">
                                <list editable="bottom" decoration-muted="state in ('draft','cancel')" decoration-success="state=='done'">
                                    <field name="sequence" string="Delivery #" readonly="1" optional="show"/>
                                    <field name="picking_id" string="Transfer" readonly="1" optional="show"/>
                                    <field name="backorder_of_id" string="Backorder Of" readonly="1" optional="show"/>
                                    <field name="batch_id" string="Batch" readonly="1" optional="show"/>
                                    <field name="lot_number" string="Lot/Serial Number" readonly="1" optional="show"/>
                                    <field name="quantity" string="Qty Received (kg)" sum="Total" readonly="1" optional="show"/>
                                    <field name="state" widget="badge" readonly="1" optional="show"/>
                                    <field name="gross_weight" string="Gross Wt (kg)" optional="show"/>
                                    <field name="tare_weight" string="Tare Wt (kg)" optional="show"/>
                                    <field name="net_weight" string="Net Wt (kg)" optional="show"/>
                                    <field name="sample_weight" string="Sample Wt (kg)" optional="show"/>
                                    <field name="sample_count" string="Shrimp Counted" optional="show"/>
                                    <field name="avg_body_weight" string="Avg Body Wt (g)" readonly="1" optional="show"/>
                                    <field name="shrimp_count" string="Count/kg" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_purchase_order_form_shrimp_count" model="ir.ui.view">
        <field name="name">purchase.order.form.shrimp.count</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty'][@readonly='is_downpayment']" position="after">
                <field name="shrimp_count" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_weighment" model="ir.ui.view">
        <field name="name">stock.picking.form.aqua.weighment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- FIX: this used to render on EVERY transfer of every operation type, including
                 the later "Aqua Processing: Quality Control" and Storage legs of a 3-step
                 receiving route, so the same Gross/Tare/Net Weight and Shrimp Counting entered
                 at the gate (Receipt) appeared to repeat, uneditable-looking and out of place,
                 on the Quality Control transfer too (see AQP/QC/00019). Weighment/Shrimp
                 Counting is a one-time, gate-only measurement, so it's now shown only on the
                 actual Receiving transfer (picking_type_id.code == 'incoming'). The Quality
                 Control step gets its own, dedicated Raw Material Quality Check section instead;
                 see the xpath below. -->
            <xpath expr="//notebook" position="before">
                <field name="aqua_is_qc_step" invisible="1"/>
                <group col="2" invisible="aqua_is_qc_step">
                    <group string="Weighment">
                        <field name="aqua_gross_weight"/>
                        <field name="aqua_tare_weight"/>
                        <field name="aqua_net_weight"/>
                    </group>
                    <group string="Shrimp Counting">
                        <field name="aqua_sample_weight"/>
                        <field name="aqua_sample_count"/>
                        <field name="aqua_avg_body_weight" readonly="1"/>
                        <field name="aqua_shrimp_count" readonly="1"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_aqua_catch_receipt" model="ir.actions.act_window">
        <field name="name">Catch Receipts</field>
        <field name="res_model">aqua.catch.receipt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>