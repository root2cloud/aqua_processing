<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_catch_receipt_list" model="ir.ui.view">
        <field name="name">aqua.catch.receipt.list</field>
        <field name="model">aqua.catch.receipt</field>
        <field name="arch" type="xml">
            <list decoration-muted="state=='cancelled'" decoration-success="state=='accepted'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="species_id"/>
                <field name="receipt_date"/>
                <field name="net_weight"/>
                <field name="batch_number"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_aqua_catch_receipt_form" model="ir.ui.view">
        <field name="name">aqua.catch.receipt.form</field>
        <field name="model">aqua.catch.receipt</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_weighment" type="object" string="Confirm Weighment"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_accept" type="object" string="Accept"
                            class="oe_highlight" invisible="state != 'weighed'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('accepted', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,weighed,accepted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_processing_orders" type="object" class="oe_stat_button" icon="fa-cogs">
                            <field name="processing_order_count" widget="statinfo" string="Processing Orders"/>
                        </button>
                        <button name="action_view_quality_tests" type="object" class="oe_stat_button" icon="fa-flask">
                            <field name="quality_test_count" widget="statinfo" string="QC Tests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="species_id"/>
                            <field name="product_id" invisible="1"/>
                            <field name="harvest_method_id"/>
                            <field name="rate_contract_id"/>
                        </group>
                        <group>
                            <field name="receipt_date"/>
                            <field name="purchase_order_id"/>
                            <field name="batch_number" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Weighment">
                        <group>
                            <field name="gross_weight"/>
                            <field name="tare_weight"/>
                            <field name="net_weight"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_aqua_catch_receipt" model="ir.actions.act_window">
        <field name="name">Catch Receipts</field>
        <field name="res_model">aqua.catch.receipt</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>