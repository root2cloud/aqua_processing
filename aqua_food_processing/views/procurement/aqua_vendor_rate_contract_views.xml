<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aqua_vendor_rate_contract_list" model="ir.ui.view">
        <field name="name">aqua.vendor.rate.contract.list</field>
        <field name="model">aqua.vendor.rate.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="species_id"/>
                <field name="rate"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>
    <record id="view_aqua_vendor_rate_contract_form" model="ir.ui.view">
        <field name="name">aqua.vendor.rate.contract.form</field>
        <field name="model">aqua.vendor.rate.contract</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_catch_receipts" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="catch_receipt_count" widget="statinfo" string="Catch Receipts"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="species_id"/>
                            <field name="rate"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_aqua_vendor_rate_contract" model="ir.actions.act_window">
        <field name="name">Vendor Rate Contracts</field>
        <field name="res_model">aqua.vendor.rate.contract</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
