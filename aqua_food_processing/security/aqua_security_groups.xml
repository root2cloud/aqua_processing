        <field name="category_id" ref="module_category_aqua"/>
        <field name="implied_ids" eval="[(4, ref('group_aqua_coldstorage_operator'))]"/>
    </record>

    <!-- Packing -->
    <record id="group_aqua_packing_operator" model="res.groups">
        <field name="name">Aqua / Packing Operator</field>
        <field name="category_id" ref="module_category_aqua"/>
        <field name="implied_ids" eval="[(4, ref('group_aqua_user'))]"/>
