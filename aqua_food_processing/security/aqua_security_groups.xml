<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_aqua" model="ir.module.category">
        <field name="name">Aqua Food Processing</field>
        <field name="sequence">25</field>
    </record>

    <!-- Base -->
    <record id="group_aqua_user" model="res.groups">
        <field name="name">Aqua / User</field>
        <field name="category_id" ref="module_category_aqua"/>
    </record>
    <record id="group_aqua_manager" model="res.groups">
        <field name="name">Aqua / Manager</field>
        <field name="category_id" ref="module_category_aqua"/>
        <field name="implied_ids" eval="[(4, ref('group_aqua_user'))]"/>
    </record>

    <!-- Procurement -->
    <record id="group_aqua_procurement_officer" model="res.groups">
        <field name="name">Aqua / Procurement Officer</field>
        <field name="category_id" ref="module_category_aqua"/>
        <field name="implied_ids" eval="[(4, ref('group_aqua_user'))]"/>
    </record>
    <record id="group_aqua_procurement_manager" model="res.groups">
        <field name="name">Aqua / Procurement Manager</field>
        <field name="category_id" ref="module_category_aqua"/>
        <field name="implied_ids" eval="[(4, ref('group_aqua_procurement_officer'))]"/>
    </record>

    <!-- Processing -->
    <record id="group_aqua_plant_operator" model="res.groups">
        <field name="name">Aqua / Plant Operator</field>
        <field name="category_id" ref="module_category_aqua"/>
        <field name="implied_ids" eval="[(4, ref('group_aqua_user'))]"/>
